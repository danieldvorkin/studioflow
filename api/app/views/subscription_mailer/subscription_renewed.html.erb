<h1>Subscription renewed ✓</h1>

<p>Hi <%= @user.name.presence || @user.email %>,</p>

<p>
  Great news — your StudioFlow <strong><%= @tier_label %></strong> subscription
  has been renewed successfully.
</p>

<% if @period_end %>
<p>
  Your next renewal date is <strong><%= @period_end.strftime('%B %-d, %Y') %></strong>.
</p>
<% end %>

<p>Thank you for being a StudioFlow customer!</p>

<% content_for :footer do %>
  You received this email because your StudioFlow subscription was renewed.
<% end %>

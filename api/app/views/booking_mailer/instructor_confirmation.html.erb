<h1>New booking: <%= @booking&.class_session&.class_template&.title || 'your class' %></h1>

<p>
  Hi <%= @booking&.class_session&.instructor&.name.presence || 'there' %>,
</p>

<p>
  A new booking has been made for one of your classes.
</p>

<ul>
  <li><strong>Client:</strong> <%= @booking&.client&.name.presence || @booking&.client&.email %></li>
  <% if (start_time = @booking&.class_session&.start_time) %>
    <li><strong>When:</strong> <%= start_time.strftime('%B %-d, %Y at %-I:%M %p') %></li>
  <% end %>
  <% if (duration = @booking&.class_session&.class_template&.duration_minutes) %>
    <li><strong>Duration:</strong> <%= duration %> minutes</li>
  <% end %>
  <% if (location_name = @booking&.class_session&.class_template&.studio_location&.name) %>
    <li><strong>Location:</strong> <%= location_name %></li>
  <% end %>
  <% if (room = @booking&.class_session&.room).present? %>
    <li><strong>Room:</strong> <%= room %></li>
  <% end %>
</ul>

<p>
  <a href="<%= @booking_url %>">View booking details</a>
</p>

<p>
  Thanks,
  <br>
  Pilates Studio
</p>

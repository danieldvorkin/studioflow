<h1>You're in — waitlist promotion</h1>

<p>
  Hi <%= @booking&.client&.name.presence || @booking&.client&.email %>,
</p>

<p>
  Good news: you were promoted from the waitlist and now have a spot in <strong><%= @booking&.class_session&.class_template&.title || 'your class' %></strong>.
</p>

<ul>
  <% if (start_time = @booking&.class_session&.start_time) %>
    <li><strong>When:</strong> <%= start_time.strftime('%B %-d, %Y at %-I:%M %p') %></li>
  <% end %>
  <% if (location_name = @booking&.class_session&.class_template&.studio_location&.name) %>
    <li><strong>Location:</strong> <%= location_name %></li>
  <% end %>
  <% if (room = @booking&.class_session&.room).present? %>
    <li><strong>Room:</strong> <%= room %></li>
  <% end %>
</ul>

<p>
  Thanks,
  <br>
  Pilates Studio
</p>

<h1>Your booking is confirmed ✓</h1>

<p>Hi <%= @booking&.client&.name.presence || @booking&.client&.email %>,</p>

<p>You're booked for <strong><%= @booking&.class_session&.class_template&.title || 'your class' %></strong>.</p>

<div class="order-card">
  <% if (start_time = @booking&.class_session&.start_time) %>
    <div class="order-row">
      <span class="lbl">When</span>
      <span class="val"><%= start_time.strftime('%B %-d, %Y at %-I:%M %p') %></span>
    </div>
  <% end %>
  <% if (duration = @booking&.class_session&.class_template&.duration_minutes) %>
    <div class="order-row">
      <span class="lbl">Duration</span>
      <span class="val"><%= duration %> minutes</span>
    </div>
  <% end %>
  <% if (location_name = @booking&.class_session&.class_template&.studio_location&.name) %>
    <div class="order-row">
      <span class="lbl">Location</span>
      <span class="val"><%= location_name %></span>
    </div>
  <% end %>
  <% if (room = @booking&.class_session&.room).present? %>
    <div class="order-row">
      <span class="lbl">Room</span>
      <span class="val"><%= room %></span>
    </div>
  <% end %>
</div>

<a href="<%= @booking_url %>" class="btn">View your booking</a>

<% content_for :footer do %>
  You received this email because you booked a class through StudioFlow.
<% end %>

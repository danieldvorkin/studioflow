<p>Hello <%= @booking.client.name.presence || 'there' %>,</p>

<p>This is a reminder that payment is still due for your class booking:</p>

<ul>
  <li><strong>Class:</strong> <%= @booking.class_session.class_template.title %></li>
  <li><strong>When:</strong> <%= @booking.class_session.start_time.strftime('%B %-d, %Y at %-I:%M %p') %></li>
  <% if (duration = @booking.class_session.class_template.duration_minutes) %>
    <li><strong>Duration:</strong> <%= duration %> minutes</li>
  <% end %>
  <% if (instructor = @booking.class_session.instructor) %>
    <li><strong>Instructor:</strong> <%= instructor.name %></li>
  <% end %>
  <% if (location_name = @booking.class_session.class_template.studio_location&.name) %>
    <li><strong>Location:</strong> <%= location_name %></li>
  <% end %>
  <% if (room = @booking.class_session.room).present? %>
    <li><strong>Room:</strong> <%= room %></li>
  <% end %>
  <% if @booking.price_cents.to_i > 0 %>
    <li><strong>Amount due:</strong> <%= number_to_currency(@booking.price_cents / 100.0) %></li>
  <% end %>
</ul>

<p>
  <a href="<%= @checkout_url %>">Pay now with secure checkout</a>
</p>

<p>
  Or <a href="<%= @booking_url %>">view your booking</a> in the app.
</p>

<p>If you already paid, you can ignore this email.</p>

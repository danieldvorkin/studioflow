<h1>Payment reminder</h1>

<p>Hello <%= @booking.client.name.presence || 'there' %>,</p>

<p>This is a reminder that payment is still due for your class booking:</p>

<div class="order-card">
  <div class="order-row">
    <span class="lbl">Class</span>
    <span class="val"><%= @booking.class_session.class_template.title %></span>
  </div>
  <div class="order-row">
    <span class="lbl">When</span>
    <span class="val"><%= @booking.class_session.start_time.strftime('%B %-d, %Y at %-I:%M %p') %></span>
  </div>
  <% if (duration = @booking.class_session.class_template.duration_minutes) %>
    <div class="order-row">
      <span class="lbl">Duration</span>
      <span class="val"><%= duration %> minutes</span>
    </div>
  <% end %>
  <% if (instructor = @booking.class_session.instructor) %>
    <div class="order-row">
      <span class="lbl">Instructor</span>
      <span class="val"><%= instructor.name %></span>
    </div>
  <% end %>
  <% if (location_name = @booking.class_session.class_template.studio_location&.name) %>
    <div class="order-row">
      <span class="lbl">Location</span>
      <span class="val"><%= location_name %></span>
    </div>
  <% end %>
  <% if (room = @booking.class_session.room).present? %>
    <div class="order-row">
      <span class="lbl">Room</span>
      <span class="val"><%= room %></span>
    </div>
  <% end %>
  <% if @booking.price_cents.to_i > 0 %>
    <div class="order-row">
      <span class="lbl">Amount due</span>
      <span class="val"><%= number_to_currency(@booking.price_cents / 100.0) %></span>
    </div>
  <% end %>
</div>

<a href="<%= @checkout_url %>" class="btn">Pay now with secure checkout</a>

<p style="font-size:13px">Or <a href="<%= @booking_url %>">view your booking</a> in the app.</p>

<p style="font-size:13px;color:#64748b">If you already paid, you can ignore this email.</p>

<% content_for :footer do %>
  You received this email because a payment is outstanding for your StudioFlow booking.
<% end %>

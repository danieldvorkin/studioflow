<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0f172a; color: #e2e8f0; margin: 0; padding: 0; }
      .wrapper { max-width: 540px; margin: 40px auto; background: #1e293b; border: 1px solid #334155; border-radius: 12px; overflow: hidden; }
      .header  { background: #0ea5e9; padding: 24px 32px; text-align: center; }
      .header h1 { margin: 0; color: #fff; font-size: 20px; font-weight: 700; letter-spacing: 0.05em; }
      .body    { padding: 32px; }
      .body p  { margin: 0 0 12px; color: #cbd5e1; font-size: 14px; line-height: 1.6; }
      .label   { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #64748b; margin-bottom: 4px; }
      .value   { background: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 12px 16px; font-size: 14px; color: #e2e8f0; margin-bottom: 16px; white-space: pre-wrap; word-break: break-word; }
      .footer  { padding: 16px 32px; border-top: 1px solid #334155; text-align: center; font-size: 11px; color: #475569; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="header">
        <h1>Studio<strong style="color:#bae6fd">Flow</strong> — New Contact Message</h1>
      </div>
      <div class="body">
        <p>Someone submitted the contact form on joinstudioflow.com. Reply directly to this email to reach them.</p>

        <div class="label">Name</div>
        <div class="value"><%= @name %></div>

        <div class="label">Email</div>
        <div class="value"><%= @email %></div>

        <div class="label">Message</div>
        <div class="value"><%= @message %></div>
      </div>
      <div class="footer">Sent by StudioFlow · joinstudioflow.com</div>
    </div>
  </body>
</html>

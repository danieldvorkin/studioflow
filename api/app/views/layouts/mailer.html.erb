<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
      /* === Reset & base === */
      body { margin: 0; padding: 0; background: #0f172a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }

      /* === Wrapper === */
      .wrapper { max-width: 560px; margin: 40px auto; background: #1e293b; border-radius: 16px; overflow: hidden; border: 1px solid #334155; }

      /* === Header === */
      .header { background: #0f172a; padding: 32px 40px 24px; border-bottom: 1px solid #334155; }
      .brand { font-size: 13px; font-weight: 700; letter-spacing: 0.25em; text-transform: uppercase; color: #38bdf8; }
      .brand strong { color: #cbd5e1; }

      /* === Body === */
      .body { padding: 36px 40px; color: #cbd5e1; }
      h1 { margin: 0 0 12px; font-size: 22px; font-weight: 700; color: #f1f5f9; }
      h2 { margin: 0 0 12px; font-size: 19px; font-weight: 700; color: #f1f5f9; }
      p { margin: 0 0 16px; font-size: 15px; line-height: 1.6; color: #94a3b8; }
      strong { color: #f1f5f9; }
      a { color: #38bdf8; }
      ul { padding-left: 20px; margin: 0 0 16px; }
      li { font-size: 15px; color: #94a3b8; line-height: 1.8; }
      li strong { color: #f1f5f9; }

      /* === CTA button === */
      .btn { display: inline-block; background: #0ea5e9; color: #fff !important; text-decoration: none; padding: 13px 28px; border-radius: 10px; font-size: 15px; font-weight: 600; margin: 8px 0 24px; }

      /* === Divider === */
      .divider { border: none; border-top: 1px solid #334155; margin: 24px 0; }

      /* === Link fallback section === */
      .link-section { background: #0f172a; border-radius: 10px; padding: 14px 16px; }
      .link-section p { margin: 0 0 6px; font-size: 12px; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em; }
      .link-section code { font-size: 12px; color: #7dd3fc; word-break: break-all; }

      /* === Order / detail card === */
      .order-card { background: #0f172a; border: 1px solid #334155; border-radius: 12px; overflow: hidden; margin-bottom: 24px; }
      .order-row { display: flex; justify-content: space-between; padding: 12px 20px; border-bottom: 1px solid #1e293b; font-size: 14px; }
      .order-row:last-child { border-bottom: none; }
      .order-row .lbl { color: #64748b; font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; }
      .order-row .val { color: #e2e8f0; font-weight: 500; text-align: right; }

      /* === Badges === */
      .badge { display: inline-block; background: #052e16; border: 1px solid #166534; color: #22c55e; border-radius: 999px; padding: 3px 12px; font-size: 12px; font-weight: 600; }
      .role-badge { display: inline-block; background: #0c1a2e; border: 1px solid #1e40af; color: #60a5fa; border-radius: 999px; padding: 3px 12px; font-size: 12px; font-weight: 600; }
      .studio-badge, .client-badge { display: inline-block; background: #0f172a; border: 1px solid #334155; border-radius: 10px; padding: 10px 16px; margin: 8px 0 20px; font-size: 14px; color: #f1f5f9; font-weight: 600; }
      .studio-badge span, .client-badge span { color: #38bdf8; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; display: block; margin-bottom: 2px; }

      /* === Credentials box === */
      .credentials-box { background: #0f172a; border: 1px solid #334155; border-radius: 10px; padding: 18px 20px; margin: 16px 0 24px; }
      .credentials-box .label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #64748b; margin-bottom: 4px; }
      .credentials-box .value { font-size: 14px; color: #f1f5f9; font-weight: 600; word-break: break-all; }
      .credentials-box .value.mono { font-family: 'Menlo', 'Courier New', monospace; color: #7dd3fc; }
      .credential-row { margin-bottom: 14px; }
      .credential-row:last-child { margin-bottom: 0; }

      /* === Warning box === */
      .warning { background: #1c1917; border: 1px solid #78350f; border-radius: 10px; padding: 12px 16px; margin: 0 0 20px; }
      .warning p { margin: 0; font-size: 13px; color: #fb923c; }

      /* === Checklist === */
      .checklist { list-style: none; padding: 0; margin: 0 0 20px; }
      .checklist li { font-size: 14px; color: #94a3b8; padding: 6px 0; }
      .checklist li::before { content: "✓ "; color: #22c55e; font-weight: 700; }

      /* === Field label / value (contact form) === */
      .field-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #64748b; margin-bottom: 4px; }
      .field-value { background: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 12px 16px; font-size: 14px; color: #e2e8f0; margin-bottom: 16px; white-space: pre-wrap; word-break: break-word; }

      /* === Expiry note === */
      .expiry { margin: 20px 0 0; font-size: 12px; color: #64748b; }

      /* === Meta / timestamp badge === */
      .meta-badge { display: inline-block; background: #0f172a; border: 1px solid #334155; border-radius: 6px; padding: 8px 16px; font-size: 12px; color: #94a3b8; margin-top: 8px; }

      /* === Footer === */
      .footer { padding: 20px 40px; font-size: 11px; color: #475569; border-top: 1px solid #334155; }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="header">
        <div class="brand">Studio<strong>Flow</strong></div>
      </div>
      <div class="body">
        <%= yield %>
      </div>
      <div class="footer">
        <%= content_for?(:footer) ? yield(:footer) : "You received this email from StudioFlow &middot; joinstudioflow.com".html_safe %>
      </div>
    </div>
  </body>
</html>

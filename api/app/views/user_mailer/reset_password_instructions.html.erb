<h1>Reset your password</h1>
<p>Hi <%= @user.name.presence || @user.email %>, we received a request to reset the password for your StudioFlow account.</p>

<a href="<%= @reset_url %>" class="btn">Reset my password</a>

<div class="warning">
  This link expires in <strong style="color:#f1f5f9">2 hours</strong>. If you didn't request a password reset, you can safely ignore this email — your password won't change.
</div>

<hr class="divider">

<p style="font-size:13px;color:#64748b">If the button doesn't work, copy and paste this link into your browser:</p>
<div class="link-section">
  <p>Reset link</p>
  <code><%= @reset_url %></code>
</div>

<% content_for :footer do %>
  You received this email because a password reset was requested for your StudioFlow account.
<% end %>

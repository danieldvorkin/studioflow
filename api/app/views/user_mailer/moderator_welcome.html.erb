<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>You've been added as a StudioFlow Moderator</title>
  <style>
    body { margin: 0; padding: 0; background: #0f172a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    .wrapper { max-width: 560px; margin: 40px auto; background: #1e293b; border-radius: 16px; overflow: hidden; border: 1px solid #334155; }
    .header { background: #0f172a; padding: 32px 40px 24px; border-bottom: 1px solid #334155; }
    .brand { font-size: 13px; font-weight: 700; letter-spacing: 0.25em; text-transform: uppercase; color: #38bdf8; }
    .brand strong { color: #cbd5e1; }
    .body { padding: 36px 40px; color: #cbd5e1; }
    h1 { margin: 0 0 12px; font-size: 22px; font-weight: 700; color: #f1f5f9; }
    p { margin: 0 0 16px; font-size: 15px; line-height: 1.6; color: #94a3b8; }
    .role-badge { display: inline-block; background: #0c1a2e; border: 1px solid #1e40af; color: #60a5fa; border-radius: 999px; padding: 3px 12px; font-size: 12px; font-weight: 600; }
    .credentials-box { background: #0f172a; border: 1px solid #334155; border-radius: 10px; padding: 18px 20px; margin: 16px 0 24px; }
    .credentials-box .label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #64748b; margin-bottom: 4px; }
    .credentials-box .value { font-size: 14px; color: #f1f5f9; font-weight: 600; word-break: break-all; }
    .credentials-box .value.mono { font-family: 'Menlo', 'Courier New', monospace; color: #7dd3fc; }
    .credential-row { margin-bottom: 14px; }
    .credential-row:last-child { margin-bottom: 0; }
    .btn { display: inline-block; background: #0ea5e9; color: #fff; text-decoration: none; padding: 13px 28px; border-radius: 10px; font-size: 15px; font-weight: 600; margin: 8px 0 24px; }
    .divider { border: none; border-top: 1px solid #334155; margin: 24px 0; }
    .warning { background: #1c1917; border: 1px solid #78350f; border-radius: 10px; padding: 12px 16px; margin: 0 0 20px; }
    .warning p { margin: 0; font-size: 13px; color: #fb923c; }
    .link-section { background: #0f172a; border-radius: 10px; padding: 14px 16px; }
    .link-section p { margin: 0 0 6px; font-size: 12px; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em; }
    .link-section code { font-size: 12px; color: #7dd3fc; word-break: break-all; }
    .footer { padding: 20px 40px; font-size: 11px; color: #475569; border-top: 1px solid #334155; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <div class="brand">Studio<strong>Flow</strong></div>
    </div>
    <div class="body">
      <h1>Welcome, Moderator 🛡️</h1>
      <p>
        You've been granted <span class="role-badge">Moderator</span> access on
        <strong style="color:#f1f5f9">StudioFlow</strong>. Use the credentials below to sign in
        and start managing studios on the platform.
      </p>

      <div class="credentials-box">
        <div class="credential-row">
          <div class="label">Email</div>
          <div class="value"><%= @user.email %></div>
        </div>
        <div class="credential-row">
          <div class="label">Temporary password</div>
          <div class="value mono"><%= @plaintext_password %></div>
        </div>
      </div>

      <div class="warning">
        <p>⚠️ Change your password after your first login. This temporary password will not be shown again.</p>
      </div>

      <a href="<%= @login_url %>" class="btn">Sign in to StudioFlow</a>

      <hr class="divider">

      <div class="link-section">
        <p>Or copy this link into your browser</p>
        <code><%= @login_url %></code>
      </div>
    </div>
    <div class="footer">
      You received this email because a StudioFlow administrator granted you moderator access.
      If this was unexpected, please contact support at support@joinstudioflow.com.
    </div>
  </div>
</body>
</html>

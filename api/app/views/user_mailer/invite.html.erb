<h1>You've been invited 🎉</h1>
<p>
  <strong style="color:#f1f5f9"><%= @invited_by.name.presence || @invited_by.email %></strong>
  has added you to <strong style="color:#f1f5f9"><%= @studio.name %></strong> on StudioFlow
  as a <% role_name = User::ROLES.key(@user.role)&.to_s&.capitalize || "team member" %><strong style="color:#60a5fa"><%= role_name %></strong>.
</p>

<div class="studio-badge">
  <span>Studio</span>
  <%= @studio.name %>
</div>

<p>Click the button below to set your password and access your account. This link expires in <strong style="color:#f1f5f9">2 hours</strong>.</p>

<a href="<%= @reset_url %>" class="btn">Set password &amp; get started</a>

<hr class="divider">

<div class="link-section">
  <p>Or copy this link into your browser</p>
  <code><%= @reset_url %></code>
</div>

<p class="expiry">If you weren't expecting this invitation, you can safely ignore this email.</p>

<% content_for :footer do %>
  You received this email because someone added you as a team member on StudioFlow.
<% end %>

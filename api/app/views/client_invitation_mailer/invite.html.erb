<h1>You're invited to <%= @studio.name %> 🎉</h1>
<p>
  <strong style="color:#f1f5f9"><%= @invited_by.name.presence || @invited_by.email %></strong>
  has invited you to join <%= @studio.name %> on StudioFlow — where you can
  book classes, manage your schedule, and get the most out of your sessions.
</p>

<a href="<%= @signup_url %>" class="btn">Accept invitation &amp; sign up</a>

<p style="font-size:13px">This invitation expires in 7 days. Once you sign up you'll be automatically connected to <%= @studio.name %>.</p>

<hr class="divider">

<p style="font-size:13px;color:#64748b">If the button doesn't work, copy and paste this link into your browser:</p>
<div class="link-section">
  <p>Invitation link</p>
  <code><%= @signup_url %></code>
</div>

<p class="expiry">This invitation expires <%= 7.days.from_now.strftime("%B %-d, %Y") %>.</p>

<% content_for :footer do %>
  You received this email because <%= @invited_by.name.presence || @invited_by.email %> invited you to join <%= @studio.name %>.
  If you weren't expecting this, you can safely ignore this email.
<% end %>

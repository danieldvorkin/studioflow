<h1>Order confirmed 🎉</h1>
<p>Thanks for your purchase, <%= @client.name.presence || @client.email %>.</p>

<div class="order-card">
  <div class="order-row">
    <span class="lbl">Item</span>
    <span class="val"><%= @item.title %></span>
  </div>
  <div class="order-row">
    <span class="lbl">Type</span>
    <span class="val"><%= @item.item_type.capitalize %></span>
  </div>
  <div class="order-row">
    <span class="lbl">Quantity</span>
    <span class="val"><%= @order.quantity %></span>
  </div>
  <div class="order-row">
    <span class="lbl">Total</span>
    <span class="val"><%= sprintf("%.2f", @order.total_cents / 100.0) %> <%= @order.currency.upcase %></span>
  </div>
  <div class="order-row">
    <span class="lbl">Status</span>
    <span class="val"><span class="badge"><%= @order.status.capitalize %></span></span>
  </div>
  <% if @order.rental_due_date %>
  <div class="order-row">
    <span class="lbl">Return by</span>
    <span class="val"><%= @order.rental_due_date.strftime('%B %-d, %Y') %></span>
  </div>
  <% end %>
</div>

<a href="<%= @orders_url %>" class="btn">View my orders</a>

<p style="font-size:13px;color:#64748b">Questions? Just reply to this email — we're happy to help.</p>

<% content_for :footer do %>
  You received this email because you placed an order through StudioFlow.
<% end %>

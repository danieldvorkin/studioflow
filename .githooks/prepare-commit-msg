#!/usr/bin/env bash
set -euo pipefail

MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"

# Git has already created the commit for merge commits; don't rewrite.
if [[ "$COMMIT_SOURCE" == "merge" ]]; then
  exit 0
fi

# Allow bypass: `SKIP_COMMIT_META=1 git commit ...`
if [[ "${SKIP_COMMIT_META:-}" == "1" ]]; then
  exit 0
fi

user_name="$(git config --get user.name || true)"
if [[ -z "$user_name" ]]; then
  user_name="${GIT_AUTHOR_NAME:-${USER:-unknown}}"
fi

# Local timestamp (minute precision keeps subject lines shorter).
now="$(date '+%Y-%m-%d %H:%M')"
prefix="[${now} ${user_name}]"

# Read current message (strip only trailing newlines for predictable formatting)
msg="$(cat "$MSG_FILE" | perl -0777 -pe 's/\n+\z//')"

# If the message is empty (shouldn't happen), just set meta as the message.
if [[ -z "$msg" ]]; then
  printf '%s\n' "$prefix" > "$MSG_FILE"
  exit 0
fi

# Prefix the existing subject line so the metadata is visible
# anywhere that only shows the first line (e.g. GitHub commit lists).
{
  subject="$(printf '%s' "$msg" | head -n 1)"
  rest="$(printf '%s' "$msg" | tail -n +2)"

  # Don't touch commented templates or empty subjects.
  if [[ -z "$subject" ]] || [[ "$subject" =~ ^# ]]; then
    printf '%s\n' "$msg"
    exit 0
  fi

  # Idempotency: skip if already prefixed.
  if printf '%s' "$subject" | grep -Eq '^\[[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2} .+\] '; then
    printf '%s\n' "$msg"
    exit 0
  fi

  printf '%s %s\n' "$prefix" "$subject"
  if [[ -n "$rest" ]]; then
    printf '%s\n' "$rest"
  fi
} > "$MSG_FILE"

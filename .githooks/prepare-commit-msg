#!/usr/bin/env bash
set -euo pipefail

MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"

# Git has already created the commit for merge commits; don't rewrite.
if [[ "$COMMIT_SOURCE" == "merge" ]]; then
  exit 0
fi

# Allow bypass: `SKIP_COMMIT_META=1 git commit ...`
if [[ "${SKIP_COMMIT_META:-}" == "1" ]]; then
  exit 0
fi

user_name="$(git config --get user.name || true)"
if [[ -z "$user_name" ]]; then
  user_name="${GIT_AUTHOR_NAME:-${USER:-unknown}}"
fi

# Local timestamp.
now="$(date '+%Y-%m-%d %H:%M:%S %z')"
meta_line="Commit-Meta: ${now} | ${user_name}"

# Skip if meta already present anywhere.
if grep -q "^Commit-Meta: " "$MSG_FILE"; then
  exit 0
fi

# Read current message (strip only trailing newlines for predictable formatting)
msg="$(cat "$MSG_FILE" | perl -0777 -pe 's/\n+\z//')"

# If the message is empty (shouldn't happen), just set meta as the message.
if [[ -z "$msg" ]]; then
  printf '%s\n' "$meta_line" > "$MSG_FILE"
  exit 0
fi

# Keep the existing subject line intact; insert metadata into the body.
#
# Result:
#   <original subject>
#
#   Commit-Meta: ...
#   <rest of original body (if any)>
{
  # Print first line (subject)
  printf '%s\n' "$(printf '%s' "$msg" | head -n 1)"

  # Rest of message (body)
  rest="$(printf '%s' "$msg" | tail -n +2)"

  printf '\n%s\n' "$meta_line"

  if [[ -n "$rest" ]]; then
    printf '%s\n' "$rest"
  fi
} > "$MSG_FILE"
